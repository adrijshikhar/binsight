---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Comparison from '../components/Comparison.astro';
import Benchmarks from '../components/Benchmarks.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import DiffSpotlight from '../components/DiffSpotlight.astro';
import SafetyTrust from '../components/SafetyTrust.astro';
import Architecture from '../components/Architecture.astro';
import CompatibilityMatrix from '../components/CompatibilityMatrix.astro';
import InstallTabs from '../components/InstallTabs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import ResourceDirectory from '../components/ResourceDirectory.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <AnnouncementBanner />
  <Navbar />
  <main id="main-content">
    <Hero />
    <Comparison />
    <DiffSpotlight />
    <Benchmarks />
    <FeatureGrid />
    <SafetyTrust />
    <Architecture />
    <CompatibilityMatrix />
    <InstallTabs />
    <FaqAccordion />
    <ResourceDirectory />
  </main>
  <Footer />
</BaseLayout>
