const headings = [
  { depth: 2, slug: 'dual-engine-concept', text: 'The Dual-Engine Oracle Concept' },
  { depth: 2, slug: 'go-mysql-workhorse', text: 'Engine 1: Native go-mysql Workhorse' },
  { depth: 2, slug: 'mysqlbinlog-oracle', text: 'Engine 2: mysqlbinlog Canonical Oracle' },
