---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`relative w-full border-t border-[#222d3d]/60 select-none ${className}`} aria-hidden="true">
  <div class="corner-diamond left-0 top-0"></div>
  <div class="corner-diamond left-full top-0"></div>
</div>
