---
import { SITE_CONFIG } from '../../data/product';

interface Props {
  size?: 'sm' | 'md';
  class?: string;
  label?: string;
}

const {
  size = 'sm',
  class: className = '',
  label,
} = Astro.props;

const isSm = size === 'sm';
---

<a
  href={SITE_CONFIG.repoUrl}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-flex items-center gap-2.5 rounded-md bg-[#161f2c] border border-[#2d3b4f] hover:border-[#58a6ff] text-[#f0f6fc] font-mono transition-all duration-150 group shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-[#58a6ff] ${
    isSm ? 'px-2.5 py-1.5 text-xs' : 'px-4 py-2.5 text-sm'
  } ${className}`}
  title="GitHub repository: Stars & Forks"
>
  <!-- GitHub Octocat -->
  <svg class={`${isSm ? 'w-4 h-4' : 'w-5 h-5'} fill-current text-[#8b949e] group-hover:text-[#f0f6fc] transition-colors`} viewBox="0 0 24 24">
    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
  </svg>

  {label && (
    <span class="text-[#c9d1d9] group-hover:text-[#f0f6fc] transition-colors">{label}</span>
  )}

  <!-- Stars -->
  <span class="inline-flex items-center gap-1 text-[#e6edf3]">
    <svg class="w-3.5 h-3.5 fill-current text-[#e3b341]" viewBox="0 0 16 16">
      <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"/>
    </svg>
    <span class="gh-stars-count font-semibold">{SITE_CONFIG.starsCount ?? 1}</span>
  </span>

  <span class="w-px h-3 bg-[#2d3b4f]"></span>

  <!-- Version Tag Pill -->
  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-[#0075de]/10 text-[#58a6ff] border border-[#0075de]/20 group-hover:border-[#0075de]/40 transition-colors">
    v{SITE_CONFIG.version}
  </span>
</a>


