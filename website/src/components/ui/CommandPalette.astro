---
// Zero-dependency Command Palette inspired by dev tool command interfaces (Zed / Linear)
---

<dialog
  id="command-palette"
  class="fixed inset-0 z-100 m-auto w-full max-w-xl rounded-xl border border-[#2d3b4f] bg-[#0e141c] p-0 text-[#f0f6fc] shadow-2xl backdrop:bg-[#070b0e]/80 backdrop:backdrop-blur-sm open:flex open:flex-col overflow-hidden font-sans"
  aria-label="Command Palette"
>
  <!-- Search Input Header -->
  <div class="flex items-center gap-3 border-b border-[#212c3d] px-4 py-3 bg-[#111722]">
    <svg class="w-4 h-4 text-[#8b949e] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <input
      type="text"
      id="cmd-palette-input"
      placeholder="Type a command or jump to section..."
      class="w-full bg-transparent font-mono text-sm text-[#f0f6fc] placeholder-[#5c6b76] focus:outline-none"
      autocomplete="off"
      spellcheck="false"
    />
    <kbd class="px-1.5 py-0.5 text-[10px] font-mono rounded border border-[#2d3b4f] bg-[#161f2c] text-[#8b949e]">ESC</kbd>
  </div>

  <!-- Results / Items List -->
  <div class="max-h-80 overflow-y-auto p-2 text-xs font-mono divide-y divide-[#1b2432]/60" id="cmd-palette-list">
    <div class="px-3 py-1.5 text-[10px] font-semibold text-[#8b949e] uppercase tracking-wider">Quick Commands</div>

    <button
      class="cmd-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-left hover:bg-[#16212e] text-[#c9d1d9] hover:text-[#38bdf8] transition-colors group"
      data-action="copy"
      data-copy="brew install adrijshikhar/tap/binsight"
    >
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-[#3fb950]"></span>
        <span>brew install adrijshikhar/tap/binsight</span>
      </div>
      <span class="text-[10px] text-[#5c6b76] group-hover:text-[#8b949e]">Copy Command</span>
    </button>

    <button
      class="cmd-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-left hover:bg-[#16212e] text-[#c9d1d9] hover:text-[#38bdf8] transition-colors group"
      data-action="copy"
      data-copy="binsight serve /var/log/mysql"
    >
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-[#38bdf8]"></span>
        <span>binsight serve /var/log/mysql</span>
      </div>
      <span class="text-[10px] text-[#5c6b76] group-hover:text-[#8b949e]">Copy Command</span>
    </button>

    <div class="px-3 py-1.5 text-[10px] font-semibold text-[#8b949e] uppercase tracking-wider mt-2">Navigation</div>

    <button
      class="cmd-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-left hover:bg-[#16212e] text-[#c9d1d9] hover:text-[#38bdf8] transition-colors"
      data-action="navigate"
      data-target="#benchmarks"
    >
      <div class="flex items-center gap-2.5">
        <span class="text-[#8b949e]">⚡</span>
        <span>Benchmarks & Telemetry Comparison</span>
      </div>
      <span class="text-[10px] text-[#5c6b76]">#benchmarks</span>
    </button>

    <button
      class="cmd-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-left hover:bg-[#16212e] text-[#c9d1d9] hover:text-[#38bdf8] transition-colors"
      data-action="navigate"
      data-target="#diff"
    >
      <div class="flex items-center gap-2.5">
        <span class="text-[#8b949e]">🔍</span>
        <span>Row-Level Image Diff Spotlight</span>
      </div>
      <span class="text-[10px] text-[#5c6b76]">#diff</span>
    </button>

    <button
      class="cmd-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-left hover:bg-[#16212e] text-[#c9d1d9] hover:text-[#38bdf8] transition-colors"
      data-action="navigate"
      data-target="#features"
    >
      <div class="flex items-center gap-2.5">
        <span class="text-[#8b949e]">📊</span>
        <span>6 Anomaly Detectors & Event Forensics</span>
      </div>
      <span class="text-[10px] text-[#5c6b76]">#features</span>
    </button>

    <button
      class="cmd-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-left hover:bg-[#16212e] text-[#c9d1d9] hover:text-[#38bdf8] transition-colors"
      data-action="navigate"
      data-target="#architecture"
    >
      <div class="flex items-center gap-2.5">
        <span class="text-[#8b949e]">📐</span>
        <span>Zero-CGO Pure Go Architecture</span>
      </div>
      <span class="text-[10px] text-[#5c6b76]">#architecture</span>
    </button>

    <button
      class="cmd-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-left hover:bg-[#16212e] text-[#c9d1d9] hover:text-[#38bdf8] transition-colors"
      data-action="external"
      data-url="https://github.com/adrijshikhar/binsight"
    >
      <div class="flex items-center gap-2.5">
        <span class="text-[#8b949e]">🐙</span>
        <span>GitHub Repository (Stars & Source)</span>
      </div>
      <span class="text-[10px] text-[#5c6b76]">github.com &rarr;</span>
    </button>
  </div>

  <!-- Palette Footer -->
  <div class="flex items-center justify-between border-t border-[#212c3d] px-4 py-2 bg-[#0b1017] text-[11px] font-mono text-[#5c6b76]">
    <div class="flex items-center gap-3">
      <span><kbd class="text-[9px] px-1 py-0.5 rounded bg-[#161f2c] border border-[#2d3b4f]">↑</kbd> <kbd class="text-[9px] px-1 py-0.5 rounded bg-[#161f2c] border border-[#2d3b4f]">↓</kbd> navigate</span>
      <span><kbd class="text-[9px] px-1 py-0.5 rounded bg-[#161f2c] border border-[#2d3b4f]">↵</kbd> select</span>
    </div>
    <div id="cmd-feedback" class="text-[#3fb950] font-semibold hidden">Copied to clipboard!</div>
  </div>
</dialog>

<script is:inline>
  (function () {
    var dialog = document.getElementById('command-palette');
    var input = document.getElementById('cmd-palette-input');
    var trigger = document.getElementById('cmd-palette-btn');
    var feedback = document.getElementById('cmd-feedback');
    if (!dialog) return;

    function openPalette() {
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
        if (input) {
          input.value = '';
          input.focus();
        }
      }
    }

    function closePalette() {
      if (typeof dialog.close === 'function') {
        dialog.close();
      }
    }

    if (trigger) {
      trigger.addEventListener('click', openPalette);
    }

    // Keyboard shortcut handler: ⌘K, Ctrl+K, or pressing '/' when not in input
    window.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        dialog.open ? closePalette() : openPalette();
      } else if (e.key === '/' && !dialog.open && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
        e.preventDefault();
        openPalette();
      }
    });

    // Close when clicking outside modal
    dialog.addEventListener('click', function (e) {
      if (e.target === dialog) {
        closePalette();
      }
    });

    // Filter items
    if (input) {
      input.addEventListener('input', function () {
        var query = input.value.toLowerCase().trim();
        var items = dialog.querySelectorAll('.cmd-item');
        items.forEach(function (btn) {
          var text = btn.textContent.toLowerCase();
          btn.style.display = text.indexOf(query) !== -1 ? 'flex' : 'none';
        });
      });
    }

    // Item clicks
    dialog.querySelectorAll('.cmd-item').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var action = btn.getAttribute('data-action');
        if (action === 'copy') {
          var copyText = btn.getAttribute('data-copy');
          if (copyText && navigator.clipboard) {
            navigator.clipboard.writeText(copyText).then(function () {
              if (feedback) {
                feedback.classList.remove('hidden');
                setTimeout(function () {
                  feedback.classList.add('hidden');
                  closePalette();
                }, 700);
              }
            });
          }
        } else if (action === 'navigate') {
          var target = btn.getAttribute('data-target');
          closePalette();
          if (target) {
            var el = document.querySelector(target);
            if (el) el.scrollIntoView({ behavior: 'smooth' });
          }
        } else if (action === 'external') {
          var url = btn.getAttribute('data-url');
          closePalette();
          if (url) window.open(url, '_blank', 'noopener,noreferrer');
        }
      });
    });
  })();
</script>
