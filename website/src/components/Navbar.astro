---
import { SITE_CONFIG, NAV_LINKS } from '../data/product';
import GitHubBadge from './ui/GitHubBadge.astro';
---

<header class="sticky top-0 z-50 border-b border-[#212c3d] bg-[#0b0f14]/90 backdrop-blur-md px-4 sm:px-6 py-3 relative">
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <!-- Brand -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#38bdf8] rounded">
      <div class="w-7 h-7 rounded-md bg-[#161f2c] border border-[#2d3b4f] flex items-center justify-center text-[#38bdf8] group-hover:border-[#38bdf8] transition-colors">
        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h10M4 18h14" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="font-mono font-bold text-lg text-[#f0f6fc] tracking-tight group-hover:text-[#38bdf8] transition-colors">binsight</span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="text-[#8b949e] hover:text-[#f0f6fc] transition-colors focus:outline-none focus-visible:text-[#38bdf8] flex items-center gap-1.5"
        >
          {link.label}
          {link.label === 'Docs' && (
            <span class="px-1 py-0.2 rounded text-[10px] font-mono bg-[#161f2c] border border-[#2d3b4f] text-[#38bdf8]">
              preview
            </span>
          )}
        </a>
      ))}
    </nav>

    <!-- Actions / Search & GitHub -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Command Palette Trigger -->
      <button
        id="cmd-palette-btn"
        class="hidden sm:inline-flex items-center gap-1.5 px-2 py-1 rounded-md border border-[#2d3b4f] bg-[#11161d] text-xs text-[#8b949e] hover:text-[#f0f6fc] hover:border-[#38bdf8]/40 transition-colors"
        title="Open Command Palette"
      >
        <svg class="w-3.5 h-3.5 text-[#8b949e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <span class="font-mono text-[11px]">Find</span>
        <kbd class="px-1 py-0.5 text-[9px] font-mono rounded bg-[#161f2c] border border-[#2d3b4f] text-[#c9d1d9] leading-none">⌘K</kbd>
      </button>

      <GitHubBadge size="sm" />

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-1.5 rounded-md border border-[#2d3b4f] bg-[#161f2c] text-[#8b949e] hover:text-[#f0f6fc]"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[#212c3d] mt-3 pt-3 flex flex-col gap-2">
    {NAV_LINKS.map((link) => (
      <a
        href={link.href}
        class="px-3 py-2 rounded text-sm text-[#8b949e] hover:text-[#f0f6fc] hover:bg-[#161f2c] transition-colors"
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
    });

    // Close on link click
    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        btn.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
      });
    });
  }
</script>
