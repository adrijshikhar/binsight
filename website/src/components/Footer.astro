---
import { SITE_CONFIG } from '../data/product';
---

<footer class="relative border-t border-[#212c3d] bg-[#070a0f] px-4 sm:px-6 py-16 text-xs text-[#8b949e]">
  <div class="corner-diamond left-0 top-0"></div>
  <div class="corner-diamond left-full top-0"></div>

  <div class="max-w-6xl mx-auto space-y-8">
    <!-- Top Bar -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-6 border-b border-[#1e293b]/60">
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded bg-[#161f2c] border border-[#2d3b4f] flex items-center justify-center text-[#38bdf8] font-mono font-bold text-xs">
          b
        </div>
        <div>
          <span class="font-bold text-[#f0f6fc] font-mono tracking-tight">binsight</span>
          <span class="text-[#4b5563] mx-2">/</span>
          <span class="text-[#8b949e]">Built by <a href={SITE_CONFIG.authorUrl} target="_blank" rel="noopener noreferrer" class="text-[#c9d1d9] hover:text-[#38bdf8] transition-colors">{SITE_CONFIG.author}</a></span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-6 font-mono text-xs">
        <a href={SITE_CONFIG.authorUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#38bdf8] transition-colors">
          adrijshikhar.dev
        </a>
        <a href={SITE_CONFIG.repoUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#38bdf8] transition-colors">
          GitHub
        </a>
        <a href={`${SITE_CONFIG.repoUrl}/releases`} target="_blank" rel="noopener noreferrer" class="hover:text-[#38bdf8] transition-colors">
          Releases (v{SITE_CONFIG.version})
        </a>
        <a href={`${SITE_CONFIG.repoUrl}/issues`} target="_blank" rel="noopener noreferrer" class="hover:text-[#38bdf8] transition-colors">
          Issues
        </a>
        <a href={`${SITE_CONFIG.repoUrl}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer" class="hover:text-[#38bdf8] transition-colors">
          MIT License
        </a>
      </div>
    </div>

    <!-- Legal & Trademark Disclaimers (inspired by uupm.cc) -->
    <div class="space-y-3 font-mono text-[11px] text-[#6b7280] leading-relaxed">
      <p>
        Binsight is an independent open-source project released under the <a href={`${SITE_CONFIG.repoUrl}/blob/main/LICENSE`} class="text-[#8b949e] hover:text-[#38bdf8] underline underline-offset-2">MIT License</a>.
        MySQL is a registered trademark of Oracle Corporation. MariaDB is a registered trademark of the MariaDB Foundation.
        Binsight is not affiliated with, endorsed by, or sponsored by Oracle Corporation or the MariaDB Foundation.
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-2 text-[10px] text-[#4b5563] border-t border-[#161f2c]">
        <span>100% Local Execution • Zero Telemetry • No External Network Calls</span>
        <span>© {new Date().getFullYear()} Adrij Shikhar. All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>
