---
import { SITE_CONFIG } from '../data/product';
---

<footer class="border-t border-[#212c3d] bg-[#0b0f14] px-6 py-12 text-xs text-[#8b949e]">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-3">
      <div class="w-6 h-6 rounded bg-[#161f2c] border border-[#2d3b4f] flex items-center justify-center text-[#38bdf8] font-mono font-bold text-xs">
        b
      </div>
      <div>
        <span class="font-bold text-[#f0f6fc] font-mono">binsight</span> — Built by <a href={SITE_CONFIG.authorUrl} target="_blank" rel="noopener noreferrer" class="text-[#c9d1d9] hover:text-[#38bdf8] transition-colors">{SITE_CONFIG.author}</a>.
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-6 font-mono">
      <a href={SITE_CONFIG.authorUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#f0f6fc] transition-colors">
        adrijshikhar.dev
      </a>
      <a href={SITE_CONFIG.repoUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#f0f6fc] transition-colors">
        GitHub
      </a>
      <a href={`${SITE_CONFIG.repoUrl}/releases`} target="_blank" rel="noopener noreferrer" class="hover:text-[#f0f6fc] transition-colors">
        Releases
      </a>
      <a href={`${SITE_CONFIG.repoUrl}/issues`} target="_blank" rel="noopener noreferrer" class="hover:text-[#f0f6fc] transition-colors">
        Issues
      </a>
      <a href={`${SITE_CONFIG.repoUrl}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer" class="hover:text-[#f0f6fc] transition-colors">
        MIT License
      </a>
    </div>
  </div>
</footer>
