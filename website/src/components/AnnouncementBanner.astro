---
import { SITE_CONFIG } from '../data/product';
---

<div class="relative w-full border-b border-[#212c3d] bg-[#0e141c] py-2 px-4 select-none overflow-hidden" aria-label="Announcement">
  <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 text-xs font-mono text-center">
    <span class="px-1.5 py-0.5 rounded bg-[#0075de]/20 text-[#58a6ff] font-semibold text-[10px] tracking-wide uppercase shrink-0">New v{SITE_CONFIG.version}</span>
    <span class="text-[#c9d1d9] hidden sm:inline">Monotonic 64-bit position accumulator & remote replica live streaming</span>
    <span class="text-[#c9d1d9] sm:hidden text-[11px]">Monotonic 64-bit & live streaming</span>
    <a href="https://github.com/adrijshikhar/binsight/releases" target="_blank" rel="noopener noreferrer" class="text-[#58a6ff] hover:underline font-semibold flex items-center gap-1 ml-1 shrink-0 text-[11px] sm:text-xs">
      Release notes <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</div>
