---
import { SITE_CONFIG } from '../data/product';
import CopyButton from './ui/CopyButton.astro';
---

<section class="relative pt-16 pb-20 md:pt-24 md:pb-32 px-6 overflow-hidden">
  <div class="max-w-5xl mx-auto text-center flex flex-col items-center">
    <!-- Tagline Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#2d3b4f] bg-[#11161d] text-xs font-mono text-[#38bdf8] mb-8 shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-[#3fb950] animate-pulse"></span>
      mysqlbinlog, but visual.
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold text-[#f0f6fc] tracking-tight leading-[1.1] mb-6 max-w-4xl">
      See what's <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#38bdf8] via-[#58a6ff] to-[#818cf8]">really happening</span> inside your binlogs.
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg md:text-xl text-[#8b949e] max-w-3xl mx-auto leading-relaxed mb-10">
      Binsight is a local, read-only visual explorer for MySQL and MariaDB binlogs.
      Inspect transactions, understand row-level changes, catch anomalies, and follow schema mutations without manually decoding raw pager output.
    </p>

    <!-- Canonical Install Box -->
    <div class="w-full max-w-xl mb-8">
      <div class="relative flex items-center justify-between rounded-xl border border-[#2d3b4f] bg-[#11161d] p-3 sm:px-4 font-mono text-sm shadow-2xl hover:border-[#38bdf8]/50 transition-colors">
        <div class="flex items-center gap-2 overflow-x-auto text-left py-0.5">
          <span class="text-[#8b949e] select-none">$</span>
          <span class="text-[#f0f6fc] select-all font-medium">{SITE_CONFIG.heroCommand}</span>
        </div>
        <CopyButton text={SITE_CONFIG.heroCommand} />
      </div>
    </div>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-16">
      <a
        href="#install"
        class="px-6 py-3 rounded-lg bg-[#38bdf8] text-[#0b0f14] font-semibold text-sm hover:bg-[#38bdf8]/90 transition-all flex items-center gap-2 shadow-lg shadow-[#38bdf8]/15 hover:shadow-[#38bdf8]/25 hover:-translate-y-0.5"
      >
        Get Started
        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path d="M19 14l-7 7m0 0l-7-7m7 7V3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a
        href={SITE_CONFIG.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 rounded-lg bg-[#151d28] border border-[#2d3b4f] hover:border-[#58a6ff] text-[#f0f6fc] font-medium text-sm transition-all flex items-center gap-2 hover:-translate-y-0.5"
      >
        <svg class="w-4 h-4 fill-current text-[#8b949e]" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        View on GitHub
      </a>
    </div>

    <!-- Product Showcase Frame -->
    <div class="w-full max-w-5xl rounded-xl border border-[#2d3b4f] bg-[#11161d] p-1.5 sm:p-2 shadow-2xl relative group">
      <!-- Glow effect -->
      <div class="absolute -inset-1 bg-gradient-to-r from-[#38bdf8]/20 via-[#58a6ff]/20 to-[#38bdf8]/10 rounded-2xl blur-xl opacity-50 group-hover:opacity-75 transition-opacity -z-10 pointer-events-none"></div>

      <!-- App Chrome Bar -->
      <div class="flex items-center justify-between px-3 py-2 bg-[#161f2c] rounded-t-lg border-b border-[#212c3d] text-xs font-mono text-[#8b949e]">
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-[#ef4444]/70"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#eab308]/70"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#22c55e]/70"></span>
          <span class="ml-3 text-[#c9d1d9] font-sans">binsight — http://localhost:8080</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-[#3fb950]"></span>
          <span class="text-[11px]">LIVE (fsnotify)</span>
        </div>
      </div>

      <!-- Real Screenshot -->
      <div class="overflow-hidden rounded-b-lg bg-[#0b0f14]">
        <img
          src="/screenshots/events-dark.png"
          alt="Binsight Events view — grouped MySQL binlog events with transaction bounds and anomaly highlights"
          width="1512"
          height="805"
          class="w-full h-auto object-cover rounded-b-lg"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
