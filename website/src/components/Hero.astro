---
import { SITE_CONFIG } from '../data/product';
import CopyButton from './ui/CopyButton.astro';
import GitHubBadge from './ui/GitHubBadge.astro';
---

<section class="relative pt-16 pb-20 md:pt-24 md:pb-32 px-4 sm:px-6 overflow-hidden">
  <!-- Corner Diamond Intersections -->
  <div class="corner-diamond left-0 top-0"></div>
  <div class="corner-diamond left-full top-0"></div>
  <div class="corner-diamond left-0 bottom-0"></div>
  <div class="corner-diamond left-full bottom-0"></div>

  <div class="max-w-5xl mx-auto text-center flex flex-col items-center">
    <!-- Tagline Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#2d3b4f] bg-[#11161d] text-xs font-mono text-[#38bdf8] mb-8 shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-[#3fb950] animate-pulse"></span>
      <span>mysqlbinlog, but visual.</span>
      <span class="w-px h-3 bg-[#2d3b4f]"></span>
      <span class="text-[#8b949e]">zero-cgo pure go</span>
    </div>

    <!-- Editorial Serif + Monospace Headline -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-serif text-[#f0f6fc] tracking-tight leading-[1.12] mb-6 max-w-4xl text-center">
      <span class="italic">See what's</span>
      <span class="font-sans font-extrabold not-italic text-[#38bdf8] px-1">really happening</span>
      <br class="hidden sm:inline" />
      <span class="italic">inside your binlogs.</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg md:text-xl text-[#8b949e] max-w-3xl mx-auto leading-relaxed mb-10 font-sans">
      Binsight is a local, read-only visual explorer for MySQL and MariaDB binlogs.
      Inspect transactions, understand row-level changes, catch anomalies, and follow schema mutations without piping through raw pager output.
    </p>

    <!-- Canonical Install Box with Keyboard Hint -->
    <div class="w-full max-w-xl mb-8">
      <div class="relative flex items-center justify-between rounded-xl border border-[#2d3b4f] bg-[#11161d] p-3 sm:px-4 font-mono text-sm shadow-xl hover:border-[#38bdf8]/50 transition-colors">
        <div class="flex items-center gap-2 overflow-x-auto text-left py-0.5">
          <span class="text-[#8b949e] select-none">$</span>
          <span class="text-[#f0f6fc] select-all font-medium">{SITE_CONFIG.heroCommand}</span>
        </div>
        <div class="flex items-center gap-2">
          <CopyButton text={SITE_CONFIG.heroCommand} />
        </div>
      </div>
    </div>

    <!-- CTAs with Dev-Tool Keyboard Hints -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-16">
      <a
        href="#install"
        class="px-6 py-3 rounded-lg bg-[#38bdf8] text-[#0b0f14] font-semibold text-sm hover:bg-[#38bdf8]/90 transition-all flex items-center gap-2"
      >
        <span>Install Now</span>
        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path d="M19 14l-7 7m0 0l-7-7m7 7V3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a
        href="#benchmarks"
        class="px-5 py-3 rounded-lg bg-[#151d28] border border-[#2d3b4f] hover:border-[#38bdf8] text-[#f0f6fc] font-medium text-sm transition-all flex items-center gap-2"
      >
        <span>Telemetry & Benchmarks</span>
        <span class="text-xs text-[#38bdf8] font-mono">⚡ 1.4s</span>
      </a>
      <GitHubBadge size="md" label="GitHub" />
    </div>

    <!-- Zed-Inspired Interactive Showcase Workbench -->
    <div class="w-full max-w-5xl rounded-xl border border-[#2d3b4f] bg-[#11161d] p-1.5 sm:p-2 shadow-2xl relative text-left">
      <!-- App Chrome Bar -->
      <div class="flex flex-wrap items-center justify-between px-3 py-2 bg-[#161f2c] rounded-t-lg border-b border-[#212c3d] text-xs font-mono text-[#8b949e] gap-2">
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-[#ef4444]/70"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#eab308]/70"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#22c55e]/70"></span>
          <span class="ml-3 text-[#c9d1d9] font-sans">binsight — http://localhost:8080</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="hidden sm:inline-flex items-center gap-1 text-[11px] text-[#8b949e]">
            <kbd class="px-1 py-0.2 rounded bg-[#0e141c] border border-[#2d3b4f] text-[10px]">1</kbd>
            <kbd class="px-1 py-0.2 rounded bg-[#0e141c] border border-[#2d3b4f] text-[10px]">2</kbd>
            <kbd class="px-1 py-0.2 rounded bg-[#0e141c] border border-[#2d3b4f] text-[10px]">3</kbd>
            switch tabs
          </span>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-[#3fb950]"></span>
            <span class="text-[11px] font-semibold text-[#f0f6fc]">LIVE (fsnotify)</span>
          </div>
        </div>
      </div>

      <!-- Workbench Feature Switcher Tabs (Dev-Tool Style) -->
      <div class="flex border-b border-[#212c3d] bg-[#0f151f] text-xs font-mono overflow-x-auto" id="showcase-tabs" role="tablist">
        <button
          class="showcase-tab active px-4 py-2.5 border-b-2 border-[#38bdf8] text-[#f0f6fc] font-semibold bg-[#161f2c]/70 flex items-center gap-2 whitespace-nowrap transition-colors"
          data-tab="events"
          role="tab"
          aria-selected="true"
        >
          <span class="text-[#38bdf8]">01</span>
          <span>Events & Timeline</span>
        </button>
        <button
          class="showcase-tab px-4 py-2.5 border-b-2 border-transparent text-[#8b949e] hover:text-[#c9d1d9] hover:bg-[#161f2c]/30 flex items-center gap-2 whitespace-nowrap transition-colors"
          data-tab="diff"
          role="tab"
          aria-selected="false"
        >
          <span class="text-[#8b949e]">02</span>
          <span>Row-Level Diffs</span>
        </button>
        <button
          class="showcase-tab px-4 py-2.5 border-b-2 border-transparent text-[#8b949e] hover:text-[#c9d1d9] hover:bg-[#161f2c]/30 flex items-center gap-2 whitespace-nowrap transition-colors"
          data-tab="overview"
          role="tab"
          aria-selected="false"
        >
          <span class="text-[#8b949e]">03</span>
          <span>Traffic & Schemas</span>
        </button>
      </div>

      <!-- Tab Panes -->
      <div class="relative overflow-hidden rounded-b-lg bg-[#0b0f14]">
        <!-- Pane 1: Events -->
        <div id="pane-events" class="showcase-pane block relative">
          <img
            src="/screenshots/events-dark.png"
            alt="Binsight Events view — grouped MySQL binlog events with transaction bounds and anomaly highlights"
            width="1512"
            height="805"
            class="w-full h-auto object-cover"
            loading="eager"
          />
          <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 flex flex-wrap gap-2 pointer-events-none">
            <span class="px-2.5 py-1 rounded-md bg-[#0b0f14]/90 border border-[#2d3b4f] text-[11px] font-mono text-[#38bdf8] backdrop-blur-md">
              ⚡ GTID Grouping
            </span>
            <span class="px-2.5 py-1 rounded-md bg-[#0b0f14]/90 border border-[#e3b341]/50 text-[11px] font-mono text-[#e3b341] backdrop-blur-md">
              ⚠️ 6 Anomaly Detectors
            </span>
            <span class="px-2.5 py-1 rounded-md bg-[#0b0f14]/90 border border-[#2d3b4f] text-[11px] font-mono text-[#c9d1d9] backdrop-blur-md">
              📍 Byte-accurate Pos
            </span>
          </div>
        </div>

        <!-- Pane 2: Diff -->
        <div id="pane-diff" class="showcase-pane hidden relative">
          <img
            src="/screenshots/diff-dark.png"
            alt="Binsight Row Diff view — before and after row values with column-level highlighting"
            width="1512"
            height="805"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 flex flex-wrap gap-2 pointer-events-none">
            <span class="px-2.5 py-1 rounded-md bg-[#0b0f14]/90 border border-[#3fb950]/50 text-[11px] font-mono text-[#3fb950] backdrop-blur-md">
              ✓ Before & After Values
            </span>
            <span class="px-2.5 py-1 rounded-md bg-[#0b0f14]/90 border border-[#2d3b4f] text-[11px] font-mono text-[#38bdf8] backdrop-blur-md">
              🔍 Column-level Change Badges
            </span>
            <span class="px-2.5 py-1 rounded-md bg-[#0b0f14]/90 border border-[#2d3b4f] text-[11px] font-mono text-[#c9d1d9] backdrop-blur-md">
              NULL & Datatype Preservation
            </span>
          </div>
        </div>

        <!-- Pane 3: Overview -->
        <div id="pane-overview" class="showcase-pane hidden relative">
          <img
            src="/screenshots/overview-dark.png"
            alt="Binsight Overview view — event distribution charts, top tables by traffic, and schema mutation breakdown"
            width="1512"
            height="805"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
          <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 flex flex-wrap gap-2 pointer-events-none">
            <span class="px-2.5 py-1 rounded-md bg-[#0b0f14]/90 border border-[#2d3b4f] text-[11px] font-mono text-[#38bdf8] backdrop-blur-md">
              📊 Write Distribution
            </span>
            <span class="px-2.5 py-1 rounded-md bg-[#0b0f14]/90 border border-[#2d3b4f] text-[11px] font-mono text-[#c9d1d9] backdrop-blur-md">
              🔥 Hot Table Activity
            </span>
            <span class="px-2.5 py-1 rounded-md bg-[#0b0f14]/90 border border-[#2d3b4f] text-[11px] font-mono text-[#8b949e] backdrop-blur-md">
              🧬 DDL Schema History
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var tabs = document.querySelectorAll('.showcase-tab');
    var panes = {
      events: document.getElementById('pane-events'),
      diff: document.getElementById('pane-diff'),
      overview: document.getElementById('pane-overview')
    };

    function selectTab(name) {
      tabs.forEach(function (tab) {
        var match = tab.getAttribute('data-tab') === name;
        tab.classList.toggle('active', match);
        tab.classList.toggle('border-[#38bdf8]', match);
        tab.classList.toggle('text-[#f0f6fc]', match);
        tab.classList.toggle('bg-[#161f2c]/70', match);
        tab.classList.toggle('border-transparent', !match);
        tab.classList.toggle('text-[#8b949e]', !match);
        tab.setAttribute('aria-selected', match ? 'true' : 'false');
      });

      for (var key in panes) {
        if (panes[key]) {
          panes[key].classList.toggle('hidden', key !== name);
          panes[key].classList.toggle('block', key === name);
        }
      }
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var name = tab.getAttribute('data-tab');
        if (name) selectTab(name);
      });
    });

    // Keyboard shortcuts: 1, 2, 3 to switch tabs when not typing
    window.addEventListener('keydown', function (e) {
      if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') return;
      if (e.key === '1') selectTab('events');
      if (e.key === '2') selectTab('diff');
      if (e.key === '3') selectTab('overview');
    });
  })();
</script>
