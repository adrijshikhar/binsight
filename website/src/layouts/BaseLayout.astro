---
import '../styles/global.css';
import { SITE_CONFIG } from '../data/product';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
} = Astro.props;

const canonicalUrl = SITE_CONFIG.url;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Binsight',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: description,
  url: canonicalUrl,
  codeRepository: SITE_CONFIG.repoUrl,
  license: 'https://opensource.org/licenses/MIT',
  author: {
    '@type': 'Person',
    name: SITE_CONFIG.author,
    url: SITE_CONFIG.authorUrl,
  },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-hidden max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Binsight" />
    <meta property="og:image" content={`${canonicalUrl}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Binsight: MySQL & MariaDB Binlog Analyzer" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${canonicalUrl}/og.png`} />
    <meta property="twitter:image:alt" content="Binsight: MySQL & MariaDB Binlog Analyzer" />

    <!-- Fonts: IBM Plex Serif for editorial devtool elegance + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400;1,600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme -->
    <meta name="theme-color" content="#0b0f14" />
    <meta name="color-scheme" content="dark" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-[#0b0f14] text-[#c9d1d9] flex flex-col selection:bg-[#38bdf8]/20 selection:text-[#38bdf8] overflow-x-hidden max-w-full">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#38bdf8] focus:text-[#0b0f14] focus:font-semibold focus:rounded-md focus:shadow-lg"
    >
      Skip to content
    </a>

    <!-- Atmospheric Ambient Lighting Wash -->
    <div class="fixed inset-0 pointer-events-none bg-ambient-radiance z-0" aria-hidden="true"></div>

    <!-- Technical Blueprint Coordinate Grid -->
    <div class="fixed inset-0 pointer-events-none bg-blueprint-grid opacity-75 z-0" aria-hidden="true"></div>

    <!-- Organic Tactile Film Grain (Zero-network GPU-safe noise) -->
    <div class="fixed inset-0 pointer-events-none bg-noise-grain opacity-35 z-0 mix-blend-screen" aria-hidden="true"></div>

    <!-- Main App Container -->
    <div class="relative z-10 flex flex-col flex-1 w-full min-h-screen overflow-x-hidden max-w-full">
      <slot />
    </div>

    <!-- Live GitHub Metrics Sync (session-cached, zero layout shift) -->
    <script is:inline>
      (function () {
        try {
          var KEY = 'binsight_gh_stats';
          var now = Date.now();
          var cached = sessionStorage.getItem(KEY);
          if (cached) {
            var data = JSON.parse(cached);
            if (now - data.time < 1800000 && data.stars != null) {
              updateDOM(data.stars, data.forks);
              return;
            }
          }
          fetch('https://api.github.com/repos/adrijshikhar/binsight')
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (repo) {
              if (repo && typeof repo.stargazers_count === 'number') {
                updateDOM(repo.stargazers_count, repo.forks_count);
                sessionStorage.setItem(KEY, JSON.stringify({
                  stars: repo.stargazers_count,
                  forks: repo.forks_count,
                  time: now
                }));
              }
            })
            .catch(function () {});

          function updateDOM(stars) {
            document.querySelectorAll('.gh-stars-count').forEach(function (el) {
              el.textContent = String(stars);
            });
          }
        } catch (e) {}
      })();
    </script>

    <!-- Anime.js Scroll & Stagger Animations -->
    <script>
      import { setupScrollAnimations } from '../scripts/animations';

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => setupScrollAnimations());
      } else {
        setupScrollAnimations();
      }
    </script>
  </body>
</html>
