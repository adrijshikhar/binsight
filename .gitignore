# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Binlog sample files (may contain internal data)
/binlog.[0-9]*
*.binlog
# …except committed sample binlogs (synthetic-workload-only, no real data):
#   - the conformance corpus the version-testing matrix validates
#   - the samples/ demo binlog shipped for first-time users to try the viewer
!internal/testdata/corpus/**/*.binlog
!samples/**/*.binlog

# Viewer state
*.db

# Go binaries
/binlog-viewer
internal/server/dist/*
!internal/server/dist/index.html
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo
website/node_modules/
website/dist/
website/.astro/
bin/

# GoReleaser output (snapshot / release artifacts)
/dist/

.playwright-mcp/

# stray screenshot captures
bv-events.png
.superpowers/

# large demo binlog — shipped as a GitHub release asset, not in git
samples/mysql-bin.000001

# local agent/session artifacts
.claude/
.codex/
.idea/
*.test
*.pprof
.DS_Store
