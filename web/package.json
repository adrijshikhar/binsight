{
  "name": "binlog-viewer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "dependencies": {
    "@mantine/core": "^9",
    "@mantine/form": "^9",
    "@mantine/hooks": "^9",
    "@mantine/notifications": "^9",
    "@radix-ui/react-slot": "^1.3.3",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-virtual": "^3.14.3",
    "agentation": "^3.0.2",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/animejs": "^3.1.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30",
    "playwright": "^1.63.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.28"
  }
}
